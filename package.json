{
  "name": "webflow-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "VITE_STAGING_AUTO_DEPLOY=1 vite build --mode staging --watch",
    "dev:local": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm lint && pnpm format:check && pnpm build",
    "deploy:staging": "pnpm build:staging && node scripts/deploy.mjs staging",
    "deploy:production": "pnpm build:production && node scripts/deploy.mjs production",
    "prepare": "husky"
  },
  "dependencies": {
    "@barba/core": "^2.10.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "dotenv": "^17.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}

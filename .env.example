# Account details — Account ID
R2_ACCOUNT_ID=
# Access key ID
R2_ACCESS_KEY_ID=
# Secret access key
R2_SECRET_ACCESS_KEY=
# Token value
R2_TOKEN=
# Bucket name
R2_BUCKET=
# Environment folder only — uploaded as {PROJECT_ID}/staging/...
R2_STAGING_PREFIX=
# Environment folder only — uploaded as {PROJECT_ID}/production/...
R2_PRODUCTION_PREFIX=
# Public URL for assets
PUBLIC_ASSET_URL=

# Optional — defaults to `name` in webflow.config.js
PROJECT_ID=

# Published Webflow staging URL — opened by `pnpm dev` with ?nc-env=dev
WEBFLOW_STAGING_URL=https://your-site.webflow.io

# Upload staging JS + CSS during `pnpm dev` (default: true)
# WEBFLOW_SYNC_STAGING=true
